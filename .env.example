# ────────────────────────────────────────────────────────────────
# ALPHA TECH — Variables de entorno (TEMPLATE)
# ────────────────────────────────────────────────────────────────
# Copiá este archivo como .env.local en tu máquina (NO subir .env.local a git)
# En Vercel, pegá estas variables en: Project → Settings → Environment Variables
# ────────────────────────────────────────────────────────────────

# ── Culqi ─────────────────────────────────────────────────────
# Llave secreta (server-side). NUNCA exponer en frontend.
# TEST: empieza con sk_test_  | LIVE: empieza con sk_live_
CULQI_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# Llave pública (puede ir en frontend, no es secreta).
# Se usa para el widget Culqi.js en checkout.html
# Esta variable la inyectamos en build-time o la pegamos directo en el HTML
CULQI_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx


# ── Resend (envío de emails) ──────────────────────────────────
# Crear cuenta en https://resend.com (free tier: 100 emails/día, 3000/mes)
# Necesitás verificar el dominio alphatechnologique.com con registros DNS
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx


# ── Notificaciones ────────────────────────────────────────────
# Email donde llegan las alertas de venta nueva
NOTIFY_EMAIL_OWNER=comercial@alphatechnologique.com


# ── HubSpot (Fase 2 — opcional por ahora) ─────────────────────
# Private App token desde HubSpot → Settings → Integrations → Private Apps
# HUBSPOT_API_KEY=pat-xxxxxxxxxxxxxxxxxxxxx
